<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{273b7da1-9264-469b-88dd-cbcc1f114e1c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR CONSTANT
	nNumMotor : USINT := 6;
END_VAR
VAR
	ASI_Axis : ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.AXIS_REF;	
	
	wcState AT %I* : ARRAY[1..nNumMotor] OF BOOL;
	
	fbPower		: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_Power;
	bEnable		: ARRAY [1..nNumMotor] OF BOOL;
	bAxisReady	: ARRAY [1..nNumMotor] OF BOOL;
	bPowerErr	: BOOL;
	nPowerErrId	: UDINT;
	
	fbMoveVelo		: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_MoveVelocity;
	bExeVelo		: ARRAY [1..nNumMotor] OF BOOL;
	fSetVelo		: LREAL := 500;	
	bMoveVeloErr	: BOOL;
	nMoveVeloErrId	: UDINT;
	fAccel			: LREAL := 1000;
	fDecel			: LREAL := 1000;
	bContUpdate		: BOOL := TRUE;
	
	fbStop		: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_Stop;
	bStop		: ARRAY [1..nNumMotor] OF BOOL;
	bStopDone	: BOOL;
	bStopErr	: BOOL;
	nStopErrId	: UDINT;
	
	fbReset		: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_Reset;
	bReset		: ARRAY [1..nNumMotor] OF BOOL;
	bResetErr	: BOOL;
	nResetErr	: UDINT;
	
	bLamp	: BOOL;
	bButton	: BOOL;
	
	fbMoveAbs		: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_MoveAbsolute;
	bExeMoveAbs		: ARRAY [1..nNumMotor] OF BOOL;
	fAbsPos			: LREAL := 0;
	fAbsMoveVelo	: LREAL := 50;
	bMoveAbsErr		: BOOL;
	nMoveAbsErrId	: UDINT;
	bfbMoveAbsDone	: BOOL;
	bMoveAbsBusy	: BOOL;
	
	fbHome			: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_Home;
	bHome			: ARRAY [1..nNumMotor] OF BOOL;
	bHomeDone		: BOOL;
	bHomeBusy		: BOOL;
	bHomeErr		: BOOL;
	nHomeErrId		: UDINT;
	
	fbSetPosition	: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_SetPosition;
	bSetPos			: ARRAY [1..nNumMotor] OF BOOL;
	fSetPostion		: LREAL := 1;
	bSetPosErr		: BOOL;
	nSetPosErrId	: UDINT;
	bSetPosDone		: BOOL;
	bSetPosBusy		: BOOL;
	
	fbMoveModulo	: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_MoveModulo;
	bExeMoveMod		: ARRAY [1..nNumMotor] OF BOOL;
	fModPosition	: LREAL;
	fModVelo		: LREAL := 100;
	bMoveModDone	: BOOL;
	bMoveModBusy	: BOOL;
	bMoveModErr		: BOOL;
	nMoveModeerrId	: UDINT;
	

	fbJog			: ARRAY [1..nNumMotor] OF Tc3_DriveMotionControl.MC_Jog;
	bJogFwd			: ARRAY [1..nNumMotor] OF BOOL;
	bJogBack		: ARRAY [1..nNumMotor] OF BOOL;
	bJogErr			: BOOL;
	nJogErrId		: UDINT;
	i				: INT;
	bEnableAll: BOOL;
	bResetAll: BOOL;
	jogForwardButton: BOOL;
	nAxis: INT;
	jogBackwardButton: BOOL;
	jogLight: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bLamp := bButton;


jogLight := fbJog[nAxis].Busy;

IF bEnableAll THEN
	FOR i := 1 TO nNumMotor DO
		bReset[i] := FALSE;
		bEnable[i] := TRUE;
	END_FOR
END_IF

IF bResetAll THEN
	FOR i := 1 TO nNumMotor DO
		bEnable[i] := FALSE;
		bReset[i] := TRUE;
	END_FOR
END_IF


IF jogForwardButton THEN
	bJogFwd[nAxis] := TRUE;
ELSE
	bJogFwd[nAxis] := FALSE;
END_IF

IF jogBackwardButton THEN
	bJogBack[nAxis] := TRUE;
ELSE
	bJogBack[nAxis] := FALSE;
END_IF


ASI_Axis[1].ReadStatus();
Asi_Axis[1].Status.SetVelo;
Asi_Axis[1].Status.ActVelo;
Asi_Axis[1].Status.SetPos;
Asi_Axis[1].Status.ActPos;


ASI_Axis[2].ReadStatus();
Asi_Axis[2].Status.SetVelo;
Asi_Axis[2].Status.ActVelo;
Asi_Axis[2].Status.SetPos;
Asi_Axis[2].Status.ActPos;

ASI_Axis[3].ReadStatus();
Asi_Axis[3].Status.SetVelo;
Asi_Axis[3].Status.ActVelo;
Asi_Axis[3].Status.SetPos;
Asi_Axis[3].Status.ActPos;

ASI_Axis[4].ReadStatus();
Asi_Axis[4].Status.SetVelo;
Asi_Axis[4].Status.ActVelo;
Asi_Axis[4].Status.SetPos;
Asi_Axis[4].Status.ActPos;

ASI_Axis[5].ReadStatus();
Asi_Axis[5].Status.SetVelo;
Asi_Axis[5].Status.ActVelo;
Asi_Axis[5].Status.SetPos;
Asi_Axis[5].Status.ActPos;

ASI_Axis[6].ReadStatus();
Asi_Axis[6].Status.SetVelo;
Asi_Axis[6].Status.ActVelo;
Asi_Axis[6].Status.SetPos;
Asi_Axis[6].Status.ActPos;

// fbPower[1](
// 	Axis:= ASI_Axis[1], 
// 	Enable:= bEnable[1], 
// 	Status=> bAxisReady[1], 
// 	Busy=> , 
// 	Active=> , 
// 	Error=> bPowerErr, 
// 	ErrorID=> nPowerErrId);
// 	
// 	fbReset[1](
// 	Axis:= ASI_Axis[1], 
// 	Execute:= bReset[1], 
// 	Done=> , 
// 	Busy=> , 
// 	Error=> bResetErr, 
// 	ErrorID=> nResetErr);

FOR i := 1 TO nNumMotor DO
	//wcState[i] := NOT wcState[i];	

fbPower[i](
	Axis:= ASI_Axis[i], 
	Enable:= bEnable[i] AND NOT wcState[i], 
	Status=> bAxisReady[i], 
	Busy=> , 
	Active=> , 
	Error=> bPowerErr, 
	ErrorID=> nPowerErrId);
	
fbMoveVelo[i](
	Axis:= ASI_Axis[i], 
	Execute:= bExeVelo[i], 
	ContinuousUpdate:= bContUpdate, 
	Velocity:= fSetVelo, 
	Acceleration:= fAccel, 
	Deceleration:= fDecel, 
	Direction:= , 
	Options:= , 
	InVelocity=> , 
	Busy=> , 
	Active=> , 
	CommandAborted=> , 
	Error=> bMoveVeloErr, 
	ErrorID=> nMoveVeloErrId);


fbMoveAbs[i](
	Axis:= ASI_Axis[i], 
	Execute:= bExeMoveAbs[i], 
	Position:= Asi_Axis[i].Status.ActPos + fAbsPos, 
	Velocity:= fAbsMoveVelo, 
	Acceleration:= fAccel, 
	Deceleration:= fAccel, 
	Options:= , 
	Done=> bfbMoveAbsDone, 
	Busy=> bMoveAbsBusy, 
	Active=> , 
	CommandAborted=> , 
	Error=> bMoveAbsErr, 
	ErrorID=> nMoveAbsErrId);

fbHome[i](
	Axis:= ASI_Axis[i], 
	Execute:= bHome[i], 
	Position:= 0, 
	HomingMode:= Tc3_DriveMotionControl.MC_HomingMode.MC_DefaultHoming, 
	Options:= , 
	Done=> bHomeDone, 
	Busy=> bHomeBusy, 
	Active=> , 
	CommandAborted=> , 
	Error=> bHomeErr, 
	ErrorID=> nHomeErrId);

fbSetPosition[i](
	Axis:= ASI_Axis[i], 
	Execute:= bSetPos[i], 
	Position:= fSetPostion, 
	Mode:= , 
	Options:= , 
	Done=> bSetPosDone, 
	Busy=> bSetPosBusy, 
	Error=> bSetPosErr, 
	ErrorID=>nSetPosErrId );
	
fbMoveModulo[i](
	Axis:= ASI_Axis[i], 
	Execute:= bExeMoveMod[i], 
	Position:= fModPosition, 
	Velocity:= fModVelo, 
	Acceleration:= fAccel, 
	Deceleration:= fDecel, 
	Direction:= MC_Direction.MC_Positive_Direction, 
	Options:= , 
	Done=> bMoveModDone, 
	Busy=> bMoveModBusy, 
	Active=> , 
	CommandAborted=> , 
	Error=> bMoveModErr, 
	ErrorID=> nMoveModeerrId);

fbJog[i](
	Axis:= ASI_Axis[i], 
	JogForward:= bJogFwd[i], 
	JogBackwards:= bJogBack[i], 
	Velocity:= fSetVelo, 
	Acceleration:= fAccel, 
	Deceleration:= fDecel, 
	Done=> , 
	Busy=> , 
	Active=> , 
	CommandAborted=> , 
	Error=> bJogErr, 
	ErrorID=> nJogErrId);

	
fbStop[i](
	Axis:= ASI_Axis[i], 
	Execute:= bStop[i], 
	Deceleration:= fDecel, 
	Options:= , 
	Done=> bStopDone, 
	Busy=> , 
	Active=> , 
	CommandAborted=> , 
	Error=> bStopErr, 
	ErrorID=>nStopErrId );
	
fbReset[i](
	Axis:= ASI_Axis[i], 
	Execute:= bReset[i], 
	Done=> , 
	Busy=> , 
	Error=> bResetErr, 
	ErrorID=> nResetErr);
	
END_FOR	]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>